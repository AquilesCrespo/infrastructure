# Compose project identity.
COMPOSE_PROJECT_NAME=infrastructure

# Host ports; change every enabled service's port for a second project.
MYSQL_PORT=3306
REDIS_PORT=6379
POSTGRES_PORT=5432
MONGO_PORT=27017
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
REDISINSIGHT_PORT=5540
S3_PORT=8333
WIREMOCK_PORT=8081
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8082
JAEGER_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Image tags (only use tags published for the corresponding image).
JAEGER_TAG=2.6.0
REDIS_EXPORTER_TAG=latest
POSTGRES_EXPORTER_TAG=latest
MYSQL_EXPORTER_TAG=latest
MYSQL_TAG=8.4
REDIS_TAG=alpine
POSTGRES_TAG=16-alpine
MONGO_TAG=7.0
MAILPIT_TAG=latest
PROMETHEUS_TAG=latest
GRAFANA_TAG=latest
REDISINSIGHT_TAG=latest
SEAWEEDFS_TAG=latest
WIREMOCK_TAG=latest
ADMINER_TAG=latest
MONGO_EXPRESS_TAG=latest

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=local_db
MYSQL_USER=dev_user
MYSQL_PASSWORD=change-me

POSTGRES_USER=dev_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=local_pg_db

MONGO_ROOT_USERNAME=dev_user
MONGO_ROOT_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

S3_ACCESS_KEY=dev_user
S3_SECRET_KEY=change-me

MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
